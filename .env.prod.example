# Plantilla del .env de producción. Normalmente lo escribe deploy.yml desde los
# secrets del repo; esto sirve para levantarlo a mano en /opt/corpforms/.env.
# Secretos sin `$` (Compose los interpola): usa `openssl rand -hex 32`.

# En minúsculas (GHCR no acepta mayúsculas).
GITHUB_REPOSITORY=algarciay/unadproject
IMAGE_TAG=main

APP_DOMAIN=corpforms.janierzapata.com
PROXY_NETWORK=proxy

POSTGRES_USER=corpforms
POSTGRES_PASSWORD=
POSTGRES_DB=corpforms

JWT_SECRET=
JWT_EXPIRATION=3600000

# Admin inicial (solo se crea si la base está vacía). Se entra con correo +
# número de documento: no dejes 123456.
ADMIN_EMAIL=
ADMIN_DOCUMENT=

# Opcional: recuperación de contraseña por correo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
